#include "head1.h"

long btoD(char bin[], int K)
{
    long num = 0;
    int i;

    for (i = 0; i < K; i++)
    {
        num = num * 2 + (bin[i] - '0');
    }

    return num;
}


void dtoB(long num, int K, char bin[])
{
    int i;

    for (i = K - 1; i >= 0; i--)
    {
        bin[i] = (num % 2) + '0';
        num /= 2;
    }

    bin[K] = '\0';
}


void inpData(char data[], int *K)
{
    printf("Enter binary string: ");
    scanf("%999s", data);

    printf("Enter block size K: ");
    scanf("%d", K);
}


long wrapsum(long sum, int K)
{
    long mv;
    long ca;

    mv = (1L << K) - 1;

    while (sum > mv)
    {
        ca = sum >> K;
        sum = (sum & mv) + ca;
    }

    return sum;
}


char *appD(char data[], int K, int *nl)
{
    int L;
    int P;
    int i;
    char *Pa;

    L = strlen(data);

    if (L % K == 0)
        P = 0;
    else
        P = K - (L % K);

    *nl = L + P;

    Pa = (char *)malloc((*nl + 1) * sizeof(char));

    if (Pa == NULL)
    {
        printf("Memory allocation failed!\n");
        exit(1);
    }

    for (i = 0; i < P; i++)
    {
        Pa[i] = '0';
    }

    strcpy(Pa + P, data);

    return Pa;
}


long *genB(char pad[], int nl, int K, int *nb)
{
    int i;
    char temp[65];
    long *values;

    *nb = nl / K;

    values = (long *)malloc((*nb) * sizeof(long));

    if (values == NULL)
    {
        printf("Memory allocation failed!\n");
        exit(1);
    }

    for (i = 0; i < *nb; i++)
    {
        strncpy(temp, pad + i * K, K);
        temp[K] = '\0';

        values[i] = btoD(temp, K);
    }

    return values;
}


long persen(long *bl, int nb, int K)
{
    long sum;
    long checks;
    long mask;
    int i;

    sum = 0;

    for (i = 0; i < nb; i++)
    {
        sum += bl[i];
        sum = wrapsum(sum, K);
    }

    mask = (1L << K) - 1;
    checks = (~sum) & mask;

    return checks;
}


int perrec(long *bl, int nb, long ch, int K)
{
    long ver;
    long res;
    long mask;
    int i;

    ver = ch;

    for (i = 0; i < nb; i++)
    {
        ver += bl[i];
        ver = wrapsum(ver, K);
    }

    mask = (1L << K) - 1;
    res = (~ver) & mask;

    if (res == 0)
        return 1;
    else
        return 0;
}


