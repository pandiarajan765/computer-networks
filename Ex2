// --- Polynomial CRC Calculation ---
uint16_t calculate_crc_polynomial(const char *data, int append_zeros) {
    uint16_t crc = 0x0000;
    for (int i = 0; data[i] != '\0'; i++) {
        uint8_t bit = data[i] - '0';
        uint8_t msb = (crc >> 15) & 1;
        crc = (crc << 1) | bit;
        if (msb) crc ^= POLY;
    }
    if (append_zeros) {
        for (int i = 0; i < 16; i++) {
            uint8_t msb = (crc >> 15) & 1;
            crc = (crc << 1);
            if (msb) crc ^= POLY;
        }
    }
    return crc;
}

// --- Specific Bit Stuffing: Stuff '0' if '0' followed by five '1's ---
