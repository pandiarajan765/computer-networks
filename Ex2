        char stuffed_payload[200];
        bit_stuff(full_payload, stuffed_payload);

        char final_frame[256];
        sprintf(final_frame, "%s%s%s", FLAG, stuffed_payload, FLAG);

        printf("\n--- Generating Frame %d ---\n", frame_num++);
        printf("Data chunk     : %s\n", data);
        printf("Calculated CRC : %s\n", crc_str); // <-- Removed Hex here
        printf("Stuffed Payload: %s\n", stuffed_payload);
        printf("Final HDLC     : %s\n", final_frame);

        fprintf(fp, "%s\n", final_frame);
    }

    fclose(fp);
    printf("\n[SENDER] Frame(s) successfully written to 'hdlc_frames.txt'.\n");
}

// --- Receiver ---
void receiver() {
    FILE *fp = fopen("hdlc_frames.txt", "r");
    if (fp == NULL) {
        printf("\n[RECEIVER] Error: 'hdlc_frames.txt' not found!\n");
        return;
    }

    char frame[256];
    int frame_num = 1;

    while (fscanf(fp, "%s", frame) != EOF) {
        printf("\n--- Processing Received Frame %d ---\n", frame_num++);

        int frame_len = strlen(frame);
        char stuffed_payload[200];
        strncpy(stuffed_payload, frame + 8, frame_len - 16);
        stuffed_payload[frame_len - 16] = '\0';

        char destuffed_payload[200];
        bit_destuff(stuffed_payload, destuffed_payload);

        uint16_t remainder = calculate_crc_polynomial(destuffed_payload, 0);

        if (remainder != 0) {
            // Convert the error remainder back to a binary string
            char rem_str[17];
            for (int i = 0; i < 16; i++) {
                rem_str[i] = ((remainder >> (15 - i)) & 1) ? '1' : '0';
            }
            rem_str[16] = '\0';

            printf("[RECEIVER] Status: ERROR DETECTED (CRC failed, Remainder: %s)\n", rem_str); // <-- Replaced Hex with Binary string
        } else {
            char extracted_data[DATA_SZ + 1];
            strncpy(extracted_data, destuffed_payload + 16, DATA_SZ);
            extracted_data[DATA_SZ] = '\0';

            char received_crc[17];
            strncpy(received_crc, destuffed_payload + strlen(destuffed_payload) - 16, 16);
            received_crc[16] = '\0';

            printf("Destuffed Payload: %s\n", destuffed_payload);
            printf("Received CRC     : %s\n", received_crc);
            printf("Status           : CORRECT\n");
            printf("Extracted Data   : %s\n", extracted_data);
        }
    }

    fclose(fp);
}
