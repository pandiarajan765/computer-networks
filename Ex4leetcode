#include <stdlib.h>
#include <math.h>

struct Cell {
    int r, c, effort;
};

int minimumEffortPath(int** heights, int heightsSize, int* heightsColSize) {
    int rows = heightsSize;
    int cols = heightsColSize[0];
    
    int** dist = (int**)malloc(rows * sizeof(int*));
    for (int i = 0; i < rows; i++) {
        dist[i] = (int*)malloc(cols * sizeof(int));
        for (int j = 0; j < cols; j++) dist[i][j] = 1e9;
    }
    dist[0][0] = 0;
    
    struct Cell* heap = (struct Cell*)malloc(rows * cols * 4 * sizeof(struct Cell));
    int heapSize = 0;
    
    heap[heapSize++] = (struct Cell){0, 0, 0};
    
    int dr[] = {-1, 1, 0, 0};
    int dc[] = {0, 0, -1, 1};
    
    while (heapSize > 0) {
        int minIdx = 0;
        for (int i = 1; i < heapSize; i++) {
            if (heap[i].effort < heap[minIdx].effort) minIdx = i;
        }
        
        struct Cell curr = heap[minIdx];
        heap[minIdx] = heap[--heapSize];
        
        if (curr.effort > dist[curr.r][curr.c]) continue;
        if (curr.r == rows - 1 && curr.c == cols - 1) break;
        
        for (int i = 0; i < 4; i++) {
            int nr = curr.r + dr[i];
            int nc = curr.c + dc[i];
            if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
                int diff = abs(heights[curr.r][curr.c] - heights[nr][nc]);
                int maxEffort = curr.effort > diff ? curr.effort : diff;
                if (maxEffort < dist[nr][nc]) {
                    dist[nr][nc] = maxEffort;
                    heap[heapSize++] = (struct Cell){nr, nc, maxEffort};
                }
            }
        }
    }
    
    int ans = dist[rows - 1][cols - 1];
    for (int i = 0; i < rows; i++) free(dist[i]);
    free(dist);
    free(heap);
    return ans;
}
