#include <stdlib.h>

struct Edge {
    int to;
    int dir;
    struct Edge* next;
};

void dfs(int node, int parent, struct Edge** adj, int* ans) {
    struct Edge* curr = adj[node];
    while (curr != NULL) {
        if (curr->to != parent) {
            if (curr->dir == 1) (*ans)++;
            dfs(curr->to, node, adj, ans);
        }
        curr = curr->next;
    }
}

int minReorder(int n, int** connections, int connectionsSize, int* connectionsColSize) {
    struct Edge** adj = (struct Edge**)calloc(n, sizeof(struct Edge*));
    struct Edge* pool = (struct Edge*)malloc(2 * connectionsSize * sizeof(struct Edge));
    int poolIdx = 0;
    
    for (int i = 0; i < connectionsSize; i++) {
        int u = connections[i][0];
        int v = connections[i][1];
        
        pool[poolIdx].to = v;
        pool[poolIdx].dir = 1;
        pool[poolIdx].next = adj[u];
        adj[u] = &pool[poolIdx++];
        
        pool[poolIdx].to = u;
        pool[poolIdx].dir = 0;
        pool[poolIdx].next = adj[v];
        adj[v] = &pool[poolIdx++];
    }
    
    int ans = 0;
    dfs(0, -1, adj, &ans);
    
    free(pool);
    free(adj);
    return ans;
}
