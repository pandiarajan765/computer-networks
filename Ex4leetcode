#include <stdlib.h>
#include <string.h>

int numBusesToDestination(int** routes, int routesSize, int* routesColSize, int source, int target) {
    if (source == target) return 0;
    int maxStop = 0;
    for (int i = 0; i < routesSize; i++) {
        for (int j = 0; j < routesColSize[i]; j++) {
            if (routes[i][j] > maxStop) maxStop = routes[i][j];
        }
    }
    if (source > maxStop || target > maxStop) return -1;
    
    int* stopCount = (int*)calloc(maxStop + 1, sizeof(int));
    for (int i = 0; i < routesSize; i++) {
        for (int j = 0; j < routesColSize[i]; j++) {
            stopCount[routes[i][j]]++;
        }
    }
    
    int** stopToBuses = (int**)malloc((maxStop + 1) * sizeof(int*));
    int* stopIdx = (int*)calloc(maxStop + 1, sizeof(int));
    for (int i = 0; i <= maxStop; i++) {
        if (stopCount[i] > 0) {
            stopToBuses[i] = (int*)malloc(stopCount[i] * sizeof(int));
        } else {
            stopToBuses[i] = NULL;
        }
    }
    
    for (int i = 0; i < routesSize; i++) {
        for (int j = 0; j < routesColSize[i]; j++) {
            int stop = routes[i][j];
            stopToBuses[stop][stopIdx[stop]++] = i;
        }
    }
    
    int* queue = (int*)malloc(100000 * sizeof(int));
    int head = 0, tail = 0;
    
    int* visitedBuses = (int*)calloc(routesSize, sizeof(int));
    int* visitedStops = (int*)calloc(maxStop + 1, sizeof(int));
    
    queue[tail++] = source;
    visitedStops[source] = 1;
    int ans = 0;
    
    while (head < tail) {
        int size = tail - head;
        for (int i = 0; i < size; i++) {
            int currStop = queue[head++];
            if (currStop == target) {
                free(stopCount);
                free(stopIdx);
                for (int j = 0; j <= maxStop; j++) free(stopToBuses[j]);
                free(stopToBuses);
                free(queue);
                free(visitedBuses);
                free(visitedStops);
                return ans;
            }
            for (int j = 0; j < stopCount[currStop]; j++) {
                int bus = stopToBuses[currStop][j];
                if (visitedBuses[bus]) continue;
                visitedBuses[bus] = 1;
                for (int k = 0; k < routesColSize[bus]; k++) {
                    int nextStop = routes[bus][k];
                    if (!visitedStops[nextStop]) {
                        visitedStops[nextStop] = 1;
                        queue[tail++] = nextStop;
                    }
                }
            }
        }
        ans++;
    }
    
    free(stopCount);
    free(stopIdx);
    for (int j = 0; j <= maxStop; j++) free(stopToBuses[j]);
    free(stopToBuses);
    free(queue);
    free(visitedBuses);
    free(visitedStops);
    return -1;
}
