struct Edge743 {
    int to;
    int weight;
    struct Edge743* next;
};

int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
    struct Edge743** adj = (struct Edge743**)calloc(n + 1, sizeof(struct Edge743*));
    struct Edge743* pool = (struct Edge743*)malloc(timesSize * sizeof(struct Edge743));
    
    for (int i = 0; i < timesSize; i++) {
        int u = times[i][0];
        int v = times[i][1];
        int w = times[i][2];
        pool[i].to = v;
        pool[i].weight = w;
        pool[i].next = adj[u];
        adj[u] = &pool[i];
    }
    
    int* dist = (int*)malloc((n + 1) * sizeof(int));
    for (int i = 1; i <= n; i++) dist[i] = 1e9;
    dist[k] = 0;
    
    int* visited = (int*)calloc(n + 1, sizeof(int));
    
    for (int i = 0; i < n; i++) {
        int u = -1;
        int minDist = 1e9;
        for (int j = 1; j <= n; j++) {
            if (!visited[j] && dist[j] < minDist) {
                minDist = dist[j];
                u = j;
            }
        }
        if (u == -1) break;
        visited[u] = 1;
        
        struct Edge743* curr = adj[u];
        while (curr != NULL) {
            if (dist[u] + curr->weight < dist[curr->to]) {
                dist[curr->to] = dist[u] + curr->weight;
            }
            curr = curr->next;
        }
    }
    
    int maxDist = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == 1e9) {
            free(adj);
            free(pool);
            free(dist);
            free(visited);
            return -1;
        }
        if (dist[i] > maxDist) maxDist = dist[i];
    }
    
    free(adj);
    free(pool);
    free(dist);
    free(visited);
    return maxDist;
}
