#include "bellman.h"
int main() {
    int graph[MAX][MAX];
    int n, num_edges, src, i, j;
    for(i = 0; i < MAX; i++) {
        for(j = 0; j < MAX; j++) {
            graph[i][j] = INT_MAX;
        }
    }
    printf("Enter number of routers: ");
    if (scanf("%d", &n) != 1 || n <= 0 || n > MAX) {
        printf("Invalid number of routers.\n");
        return 1;
    }
    printf("Enter number of edges: ");
    if (scanf("%d", &num_edges) != 1 || num_edges < 0) {
        printf("Invalid number of edges.\n");
        return 1;
    }
    printf("Enter edges in format (source destination cost):\n");
    for(i = 0; i < num_edges; i++) {
        int u, v, cost;
        if (scanf("%d %d %d", &u, &v, &cost) != 3) {
            printf("Invalid data input format.\n");
            return 1;
        }
        if(u < 1 || u > n || v < 1 || v > n) {
            printf("Invalid router vertices. Try this edge again.\n");
            i--;
            continue;
        }
        graph[u - 1][v - 1] = cost;
        graph[v - 1][u - 1] = cost;
    }
    printf("Enter source router: ");
    if (scanf("%d", &src) != 1 || src < 1 || src > n) {
        printf("Invalid source router.\n");
        return 1;
    }
    src--;
    int* result_dist = bellman_ford(graph, n, src);
    if (result_dist == NULL) {
        printf("Negative Circle exist in the graph\n");
    } else {
        printf("\nShortest paths from Router %d:\n", src + 1);
        for (i = 0; i < n; i++) {
            if (result_dist[i] == INT_MAX)
                printf("Router %d -> Router %d = INF\n", src + 1, i + 1);
            else
                printf("Router %d -> Router %d = %d\n", src + 1, i + 1, result_dist[i]);
        }
    }
    return 0;
}
