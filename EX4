#include "head.h"

// Helper function to find the first step from source to dest
int getNextHop(int parent[], int source, int dest) {
    if (dest == source) return source; // Arrived at source
    if (parent[dest] == source) return dest; // Directly connected step
    return getNextHop(parent, source, parent[dest]); // Move back one step
}

void dijkstra(int graph[MAX][MAX], int n, int source)
{
    int distance[MAX];
    int visited[MAX];
    int parent[MAX]; // Tracks the immediate predecessor node
    int i, j, min, u;

    for (i = 0; i < n; i++)
    {
        distance[i] = INF;
        visited[i] = 0;
        parent[i] = -1; // -1 means no parent assigned yet
    }

    distance[source] = 0;

    for (i = 0; i < n - 1; i++)
    {
        min = INF;
        u = -1;

        for (j = 0; j < n; j++)
        {
            if (!visited[j] && distance[j] < min)
            {
                min = distance[j];
                u = j;
            }
        }

        if (u == -1)
            break;

        visited[u] = 1;

        for (j = 0; j < n; j++)
        {
            if (graph[u][j] != 0 &&
                !visited[j] &&
                distance[u] + graph[u][j] < distance[j])
            {
                distance[j] = distance[u] + graph[u][j];
                parent[j] = u; // Track that we reached 'j' through 'u'
            }
        }
    }

    printf("\n%-12s %-10s %-10s\n", "Destination", "Cost", "Next Hop");
    printf("----------------------------------\n");

    for (i = 0; i < n; i++)
    {
        if (distance[i] == INF) {
            printf("To vertex %-2d: %-10s %-10s\n", i, "INF", "None");
        }
        else if (i == source) {
            printf("To vertex %-2d: %-10d %-10s\n", i, distance[i], "- (Source)");
        }
        else {
            int hop = getNextHop(parent, source, i);
            printf("To vertex %-2d: %-10d %-10d\n", i, distance[i], hop);
        }
    }
}
