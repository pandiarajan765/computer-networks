    while (1)
    {
        printf("Enter edge: ");
        scanf("%d %d %d", &source, &destination, &weight);

        if (source == 0 && destination == 0 && weight == 0)
            break;

        graph[source][destination] = weight;
        graph[destination][source] = weight;
    }

    printf("\nEnter source vertex: ");
    scanf("%d", &start);

    dijkstra(graph, n, start);

    return 0;
}

