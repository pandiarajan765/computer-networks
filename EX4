#include "bellman.h"
static int dist[MAX];
int* bellman_ford(int graph[MAX][MAX], int n, int source)
{
    int i, u, v, count;
    for (i = 0; i < n; i++)
        dist[i] = INT_MAX;
    dist[source] = 0;
    for (count = 0; count < n - 1; count++)
        for (u = 0; u < n; u++)
            for (v = 0; v < n; v++)
               if (graph[u][v] != INT_MAX && dist[u] != INT_MAX)
                   if (dist[u] + graph[u][v] < dist[v])
                       dist[v] = dist[u] + graph[u][v];
    for (u = 0; u < n; u++)
       for (v = 0; v < n; v++)
           if (graph[u][v] != INT_MAX && dist[u] != INT_MAX)
               if (dist[u] + graph[u][v] < dist[v])
                   return NULL;
    return dist;
}
