#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define BUFFER_SIZE 256

// Helper function to strip trailing newlines and spaces
void trim(char *str) {
size_t len = strlen(str);
while (len > 0 && (str[len - 1] == '\n' || str[len - 1] == '\r' || str[len - 1] == ' ')) {
str[--len] = '\0';
}

}

int main() {
int sockfd;
struct sockaddr_in addr, client_addr;
socklen_t addr_len = sizeof(client_addr);

sockfd = socket(AF_INET, SOCK_DGRAM, 0);
if (sockfd < 0) {
perror("Socket creation failed");
exit(EXIT_FAILURE);
}

addr.sin_family = AF_INET;
addr.sin_port = htons(PORT);
addr.sin_addr.s_addr = INADDR_ANY;

if (bind(sockfd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
perror("Bind failed");

close(sockfd);
exit(EXIT_FAILURE);
}

printf("ARP Server running on port %d...\n", PORT);

char ip[BUFFER_SIZE];
char line[BUFFER_SIZE];

while (1) {
memset(ip, 0, sizeof(ip));
ssize_t bytes = recvfrom(sockfd, ip, sizeof(ip) - 1, 0, (struct sockaddr *)&client_addr, &addr_len);
if (bytes < 0) continue;

ip[bytes] = '\0';
trim(ip);
printf("Received Request for IP: %s\n", ip);

FILE *ptr = fopen("server_map.txt", "r");
if (ptr == NULL) {
perror("Could not open server_map.txt");
char *err_msg = "MAC not found in DB";
sendto(sockfd, err_msg, strlen(err_msg), 0, (struct sockaddr *)&client_addr, addr_len);
continue;
}

int found = 0;
while (fgets(line, sizeof(line), ptr) != NULL) {
trim(line);
if (strlen(line) == 0) continue;

// Extract only the IP portion for exact comparison
char file_ip[64] = {0};
sscanf(line, "%s", file_ip);

if (strcmp(file_ip, ip) == 0) {

sendto(sockfd, line, strlen(line), 0, (struct sockaddr *)&client_addr, addr_len);
found = 1;
break;
}
}

if (!found) {
char *not_found = "MAC not found in DB";
sendto(sockfd, not_found, strlen(not_found), 0, (struct sockaddr *)&client_addr, addr_len);
}

fclose(ptr);
}

close(sockfd);
return 0;
}
