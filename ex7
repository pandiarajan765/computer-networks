#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define MAX_CACHE 10
#define BUFFER_SIZE 256

// Helper function to strip trailing newlines and spaces
void trim(char *str) {
size_t len = strlen(str);
while (len > 0 && (str[len - 1] == '\n' || str[len - 1] == '\r' || str[len - 1] == ' ')) {
str[--len] = '\0';
}

}

// Search cache for exact IP match
int search_cache(const char *ip, char *out_entry) {
FILE *ptr = fopen("client_map.txt", "r");
if (ptr == NULL) return 0;

char line[BUFFER_SIZE];
int found = 0;

while (fgets(line, sizeof(line), ptr) != NULL) {
trim(line);
if (strlen(line) == 0) continue;

char cached_ip[64] = {0};
sscanf(line, "%s", cached_ip);

if (strcmp(cached_ip, ip) == 0) {
strcpy(out_entry, line);

found = 1;
break;
}
}

fclose(ptr);
return found;
}

// Update cache adhering to MAX_CACHE=10 with FIFO eviction
void update_cache(const char *new_entry) {
char cache[MAX_CACHE][BUFFER_SIZE];
int count = 0;

FILE *ptr = fopen("client_map.txt", "r");
if (ptr != NULL) {
char line[BUFFER_SIZE];
while (fgets(line, sizeof(line), ptr) != NULL) {
trim(line);

if (strlen(line) > 0 && count < MAX_CACHE) {
strcpy(cache[count++], line);
}
}
fclose(ptr);
}

if (count < MAX_CACHE) {
strcpy(cache[count++], new_entry);
} else {
// Cache is full (10 entries): shift left (FIFO) and replace oldest (index 0)
for (int i = 0; i < MAX_CACHE - 1; i++) {
strcpy(cache[i], cache[i + 1]);
}
strcpy(cache[MAX_CACHE - 1], new_entry);
}

ptr = fopen("client_map.txt", "w");
if (ptr == NULL) {

perror("Could not write to client_map.txt");
return;
}

for (int i = 0; i < count; i++) {
fprintf(ptr, "%s\n", cache[i]);
}
fclose(ptr);
}

int main() {
int sockfd;
struct sockaddr_in addr;
socklen_t addr_len = sizeof(addr);

sockfd = socket(AF_INET, SOCK_DGRAM, 0);
if (sockfd < 0) {
perror("Socket creation failed");
exit(EXIT_FAILURE);
}


addr.sin_family = AF_INET;
addr.sin_port = htons(PORT);
inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr);

char ipmac[BUFFER_SIZE];
char ip[BUFFER_SIZE];

while (1) {
printf("\nEnter IP to find MAC (or 'exit' to quit): ");
if (scanf("%s", ip) != 1 || strcmp(ip, "exit") == 0) {
break;
}

memset(ipmac, 0, sizeof(ipmac));

if (search_cache(ip, ipmac)) {
printf("MAC IP mapped in cache:\n%s\n", ipmac);
} else {
printf("Not found in cache\n");


sendto(sockfd, ip, strlen(ip), 0, (struct sockaddr *)&addr, addr_len);

memset(ipmac, 0, sizeof(ipmac));
ssize_t bytes = recvfrom(sockfd, ipmac, sizeof(ipmac) - 1, 0, (struct sockaddr *)&addr, &addr_len);
if (bytes > 0) {
ipmac[bytes] = '\0';
trim(ipmac);
}

printf("Response from Server:\n%s\n", ipmac);

// Avoid writing error messages to local cache
if (strstr(ipmac, "not found") == NULL && strstr(ipmac, "Not Found") == NULL) {
update_cache(ipmac);
}

}
}

close(sockfd);
return 0;
}
