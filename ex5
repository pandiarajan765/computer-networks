#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000

/* Send integer */
void send_int(int sock, int value)
{
    send(sock, &value, sizeof(value), 0);
}

/* Receive integer */
int receive_int(int sock)
{
    int value;
    int bytes;

    bytes = recv(sock, &value, sizeof(value), 0);

    if (bytes <= 0)
        return -999;

    return value;
}


/* --------------------------------------------------
   RUN ARQ PROTOCOL
   -------------------------------------------------- */
void run_protocol(int sock)
{
    int n;
    int window;
    int lost_frame;
    int lost_ack;
    int out_of_order;
    int event;

    printf("\n====================================\n");
    printf("        ARQ SIMULATION INPUT\n");
    printf("====================================\n");

    printf("Enter number of frames: ");
    scanf("%d", &n);

    printf("Enter window size: ");
    scanf("%d", &window);

    printf("Enter frame to lose (-1 for none): ");
    scanf("%d", &lost_frame);

    printf("Enter ACK to lose (-1 for none): ");
    scanf("%d", &lost_ack);

    printf("Enter frame to arrive out-of-order (-1 for none): ");
    scanf("%d", &out_of_order);

    /* Send parameters to server */
    send_int(sock, n);
    send_int(sock, window);
    send_int(sock, lost_frame);
    send_int(sock, lost_ack);
    send_int(sock, out_of_order);

    printf("\n====================================\n");
    printf("       STARTING ARQ SIMULATION\n");
    printf("====================================\n");

    while (1)
    {
        event = receive_int(sock);

        if (event == -999)
        {
            printf("\nServer disconnected.\n");
            break;
        }

        if (event == -1)
        {
            printf("\nAll frames successfully acknowledged.\n");
            break;
        }

        else if (event == -2)
        {
            printf(">>> Frame loss detected.\n");
        }

        else if (event == -3)
        {
            printf(">>> Out-of-order frame detected/discarded.\n");
        }

        else if (event == -4)
        {
            printf(">>> ACK loss detected.\n");
        }

        else if (event == -5)
        {
            printf(">>> Timeout -> Go-Back-N retransmission started.\n");
        }

        else if (event == -6)
        {
            printf(">>> Selective retransmission started.\n");
        }

        else if (event > 0)
        {
            printf(">>> Received ACK %d\n", event);
        }
    }
}


/* --------------------------------------------------
   MAIN CLIENT
   -------------------------------------------------- */
int main()
{
    int client_socket;
    int choice;

    struct sockaddr_in server_address;

    /* Create socket */
    client_socket = socket(
        AF_INET,
        SOCK_STREAM,
        0
    );

    if (client_socket < 0)
    {
        printf("Socket creation failed!\n");
        return 1;
    }

    /* Configure server address */
    server_address.sin_family = AF_INET;
    server_address.sin_port = htons(PORT);

    if (inet_pton(
            AF_INET,
            "127.0.0.1",
            &server_address.sin_addr) <= 0)
    {
        printf("Invalid server address!\n");

        close(client_socket);

        return 1;
    }

    /* Connect to server */
    if (connect(
            client_socket,
            (struct sockaddr *)&server_address,
            sizeof(server_address)) < 0)
    {
        printf("Connection failed!\n");
        printf("Make sure server is running first.\n");

        close(client_socket);

        return 1;
    }

    printf("\n====================================\n");
    printf("     CONNECTED TO ARQ SERVER\n");
    printf("====================================\n");

    /* Client menu */
    while (1)
    {
        printf("\n");
        printf("========== MENU ==========\n");
        printf("1. Go-Back-N\n");
        printf("2. Selective Repeat\n");
        printf("3. Exit\n");
        printf("==========================\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        send_int(client_socket, choice);

        if (choice == 1 || choice == 2)
        {
            run_protocol(client_socket);
        }
        else if (choice == 3)
        {
            printf("\nExiting client...\n");
            break;
        }
        else
        {
            printf("\nInvalid choice!\n");
        }
    }

    close(client_socket);

    return 0;
}
