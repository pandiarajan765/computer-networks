#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 5000
#define MAX_FRAMES 100

/* Send an integer through socket */
void send_int(int sock, int value)
{
    send(sock, &value, sizeof(value), 0);
}

/* Receive an integer from socket */
int receive_int(int sock)
{
    int value;
    int bytes;

    bytes = recv(sock, &value, sizeof(value), 0);

    if (bytes <= 0)
        return -999;

    return value;
}

/* --------------------------------------------------
   GO-BACK-N ARQ
   -------------------------------------------------- */
void go_back_n(int sock)
{
    int n, window;
    int lost_frame, lost_ack, out_of_order;
    int base = 1;
    int acked[MAX_FRAMES + 1];
    int i, end;

    n = receive_int(sock);
    window = receive_int(sock);
    lost_frame = receive_int(sock);
    lost_ack = receive_int(sock);
    out_of_order = receive_int(sock);

    if (n <= 0 || n > MAX_FRAMES)
        return;

    for (i = 0; i <= MAX_FRAMES; i++)
        acked[i] = 0;

    printf("\n====================================\n");
    printf("       GO-BACK-N ARQ STARTED\n");
    printf("====================================\n");

    while (base <= n)
    {
        end = base + window - 1;

        if (end > n)
            end = n;

        printf("\nCurrent Window: ");

        for (i = base; i <= end; i++)
            printf("[%d] ", i);

        printf("\n");

        for (i = base; i <= end; i++)
        {
            if (acked[i] == 1)
                continue;

            printf("\nSending Frame %d\n", i);

            /* Simulate frame loss */
            if (i == lost_frame)
            {
                printf("Frame %d LOST\n", i);

                send_int(sock, -2);

                lost_frame = -1;
                continue;
            }

            /*
             * Simulate an out-of-order frame.
             * If selected frame is in current window and is not
             * the expected base frame, receiver discards it.
             */
            if (i == out_of_order && i != base)
            {
                printf("Frame %d arrived OUT OF ORDER\n", i);
                printf("Frame %d discarded\n", i);

                send_int(sock, -3);

                out_of_order = -1;
                continue;
            }

            /* Simulate ACK loss */
            if (i == lost_ack)
            {
                printf("Frame %d accepted\n", i);
                printf("ACK %d LOST\n", i);

                send_int(sock, -4);

                acked[i] = 0;
                lost_ack = -1;

                continue;
            }

            /* Normal frame transmission */
            printf("Receiver accepted Frame %d\n", i);
            printf("ACK %d sent\n", i);

            send_int(sock, i);

            acked[i] = 1;

            base++;

            usleep(200000);
        }

        /*
         * If the base frame has not been acknowledged,
         * timeout occurs.
         */
        if (base <= n && acked[base] == 0)
        {
            printf("\nTIMEOUT occurred\n");
            printf("Go-Back-N retransmission from Frame %d\n", base);

            send_int(sock, -5);

            /*
             * Retransmission is handled by the next iteration.
             */
        }
    }

    printf("\nAll frames successfully acknowledged.\n");

    /* Tell client that protocol is complete */
    send_int(sock, -1);
}


/* --------------------------------------------------
   SELECTIVE REPEAT ARQ
   -------------------------------------------------- */
void selective_repeat(int sock)
{
    int n, window;
    int lost_frame, lost_ack, out_of_order;
    int base = 1;
    int received[MAX_FRAMES + 1];

    int i, end;

    n = receive_int(sock);
    window = receive_int(sock);
    lost_frame = receive_int(sock);
    lost_ack = receive_int(sock);
    out_of_order = receive_int(sock);

    if (n <= 0 || n > MAX_FRAMES)
        return;

    for (i = 0; i <= MAX_FRAMES; i++)
        received[i] = 0;

    printf("\n====================================\n");
    printf("      SELECTIVE REPEAT ARQ STARTED\n");
    printf("====================================\n");

    while (base <= n)
    {
        end = base + window - 1;

        if (end > n)
            end = n;

        printf("\nCurrent Window: ");

        for (i = base; i <= end; i++)
            printf("[%d] ", i);

        printf("\n");

        for (i = base; i <= end; i++)
        {
            if (received[i] == 1)
                continue;

            printf("\nSending Frame %d\n", i);

            /* Frame loss */
            if (i == lost_frame)
            {
                printf("Frame %d LOST\n", i);

                send_int(sock, -2);

                lost_frame = -1;
                continue;
            }

            /* Out-of-order simulation */
            if (i == out_of_order)
            {
                printf("Frame %d arrived OUT OF ORDER\n", i);
                printf("Frame %d buffered by receiver\n", i);

                send_int(sock, -3);

                /*
                 * Selective Repeat can buffer out-of-order frames.
                 */
                received[i] = 1;

                out_of_order = -1;

                continue;
            }

            /* ACK loss */
            if (i == lost_ack)
            {
                printf("Frame %d accepted\n", i);
                printf("ACK %d LOST\n", i);

                send_int(sock, -4);

                /*
                 * Frame is actually received.
                 * Only ACK is lost.
                 */
                received[i] = 1;

                lost_ack = -1;

                continue;
            }

            /* Normal transmission */
            printf("Frame %d accepted & buffered\n", i);
            printf("ACK %d sent\n", i);

            send_int(sock, i);

            received[i] = 1;

            usleep(200000);
        }

        /*
         * Move base forward for all consecutively received frames.
         */
        while (base <= n && received[base] == 1)
        {
            base++;
        }

        /*
         * If base frame is still missing, retransmit ONLY that frame.
         */
        if (base <= n && received[base] == 0)
        {
            printf("\nSelective Repeat Timeout\n");
            printf("Retransmitting ONLY Frame %d\n", base);

            send_int(sock, -6);

            /*
             * Simulate successful retransmission.
             */
            send_int(sock, base);

            received[base] = 1;

            base++;
        }
    }

    printf("\nAll frames successfully acknowledged.\n");

    send_int(sock, -1);
}


/* --------------------------------------------------
   MAIN SERVER
   -------------------------------------------------- */
int main()
{
    int server_socket;
    int client_socket;
    int choice;

    struct sockaddr_in server_address;

    /* Create socket */
    server_socket = socket(AF_INET, SOCK_STREAM, 0);

    if (server_socket < 0)
    {
        printf("Socket creation failed!\n");
        return 1;
    }

    /* Allow address reuse */
    int opt = 1;

    setsockopt(
        server_socket,
        SOL_SOCKET,
        SO_REUSEADDR,
        &opt,
        sizeof(opt)
    );

    /* Configure server address */
    server_address.sin_family = AF_INET;
    server_address.sin_port = htons(PORT);
    server_address.sin_addr.s_addr = INADDR_ANY;

    /* Bind */
    if (bind(
            server_socket,
            (struct sockaddr *)&server_address,
            sizeof(server_address)) < 0)
    {
        printf("Bind failed!\n");
        close(server_socket);
        return 1;
    }

    /* Listen */
    if (listen(server_socket, 5) < 0)
    {
        printf("Listen failed!\n");
        close(server_socket);
        return 1;
    }

    printf("====================================\n");
    printf("       ARQ SERVER\n");
    printf("====================================\n");

    printf("Server listening on port %d...\n", PORT);

    /* Accept client */
    client_socket = accept(
        server_socket,
        NULL,
        NULL
    );

    if (client_socket < 0)
    {
        printf("Accept failed!\n");

        close(server_socket);

        return 1;
    }

    printf("Client connected successfully!\n");

    /* Main server loop */
    while (1)
    {
        choice = receive_int(client_socket);

        if (choice == -999)
        {
            printf("Client disconnected.\n");
            break;
        }

        if (choice == 1)
        {
            printf("\nClient selected Go-Back-N.\n");

            go_back_n(client_socket);
        }
        else if (choice == 2)
        {
            printf("\nClient selected Selective Repeat.\n");

            selective_repeat(client_socket);
        }
        else if (choice == 3)
        {
            printf("\nClient requested exit.\n");
            break;
        }
        else
        {
            printf("\nInvalid choice received.\n");
        }
    }

    close(client_socket);
    close(server_socket);

    printf("\nServer terminated.\n");

    return 0;
}
