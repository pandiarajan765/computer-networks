#include<stdio.h>
#include<stdlib.h>
#include<string.h>

#define START_FLAG "01111110"
#define ADDR "11111111"
#define CTRL "00000000"
#define FCS "00000000000000000000000000000000"
#define END_FLAG "01111110"
#define MAX_FRAMES 100
#define DATA_SZ 16
#define MAX 64
#define ESC "01111101"
#define FLAG "01111110"

typedef struct Frame {
    char sflag[9];
    char addr[9];
    char control[9];
    char data[MAX+1];
    char fcs[33];
    char eflag[9];
} f;

void bitStuff(struct Frame frames[], int nframe);
void byteStuff(struct Frame frames[], int nframe);
void bitDestuff(char* framefile);
void byteDestuff(char* framefile);
int readFile(char *ipfile, struct Frame f[]);
void writeFile(char* opfile);

